{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KGGML_RUNTIME_PORTABLE_CPU": "ON"
      }
    },
    {
      "name": "host-base",
      "hidden": true,
      "inherits": "base",
      "description": "Host desktop build into <repo>/build/native so `ctest --test-dir build/native` works.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/native",
      "installDir": "${sourceDir}/../../build/native-install",
      "cacheVariables": {
        "KGGML_RUNTIME_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x86_64 (host, tests)",
      "inherits": "host-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "KGGML_X86_LEVEL": "AVX2"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64 (host, tests, Metal + Accelerate)",
      "inherits": "host-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3",
        "KGGML_ENABLE_METAL": "ON",
        "KGGML_ENABLE_BLAS": "ON"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (host, tests, MSVC)",
      "inherits": "host-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "KGGML_X86_LEVEL": "AVX2"
      }
    },
    {
      "name": "android-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/native-${presetName}",
      "installDir": "${sourceDir}/../../build/native-install/${presetName}",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_shared",
        "KGGML_RUNTIME_BUILD_TESTS": "OFF",
        "KGGML_ENABLE_VULKAN": "OFF"
      }
    },
    {
      "name": "android-arm64-v8a",
      "displayName": "Android arm64-v8a (NEON + dotprod + fp16)",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "KGGML_ARM_ARCH": "armv8.2-a+dotprod+fp16"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android x86_64 (emulator, SSE4.2 baseline)",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64",
        "KGGML_X86_LEVEL": "SSE42"
      }
    },
    {
      "name": "ios-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/../../build/native-${presetName}",
      "installDir": "${sourceDir}/../../build/native-install/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.4",
        "CMAKE_XCODE_ATTRIBUTE_ONLY_ACTIVE_ARCH": "NO",
        "KGGML_RUNTIME_MONOLITHIC": "ON",
        "KGGML_RUNTIME_BUILD_TESTS": "OFF",
        "KGGML_ENABLE_METAL": "ON",
        "KGGML_ENABLE_BLAS": "ON",
        "KGGML_ENABLE_VULKAN": "OFF"
      }
    },
    {
      "name": "macos-framework",
      "displayName": "macOS arm64 (GgmlRuntime.framework for Kotlin/Native macosArm64, Metal + Accelerate)",
      "inherits": "base",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/../../build/native-${presetName}",
      "installDir": "${sourceDir}/../../build/native-install/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3",
        "CMAKE_XCODE_ATTRIBUTE_ONLY_ACTIVE_ARCH": "NO",
        "KGGML_RUNTIME_MONOLITHIC": "ON",
        "KGGML_RUNTIME_BUILD_TESTS": "OFF",
        "KGGML_ENABLE_METAL": "ON",
        "KGGML_ENABLE_BLAS": "ON",
        "KGGML_ENABLE_VULKAN": "OFF"
      }
    },
    {
      "name": "ios-device",
      "displayName": "iOS device arm64 (GgmlRuntime.framework)",
      "inherits": "ios-base",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphoneos"
      }
    },
    {
      "name": "ios-simulator-arm64",
      "displayName": "iOS simulator arm64 (GgmlRuntime.framework)",
      "inherits": "ios-base",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphonesimulator"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-x64", "configurePreset": "linux-x64" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "windows-x64", "configurePreset": "windows-x64" },
    { "name": "android-arm64-v8a", "configurePreset": "android-arm64-v8a" },
    { "name": "android-x86_64", "configurePreset": "android-x86_64" },
    { "name": "macos-framework", "configurePreset": "macos-framework", "configuration": "Release" },
    { "name": "ios-device", "configurePreset": "ios-device", "configuration": "Release" },
    { "name": "ios-simulator-arm64", "configurePreset": "ios-simulator-arm64", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "linux-x64", "configurePreset": "linux-x64", "output": { "outputOnFailure": true } },
    { "name": "macos-arm64", "configurePreset": "macos-arm64", "output": { "outputOnFailure": true } },
    { "name": "windows-x64", "configurePreset": "windows-x64", "output": { "outputOnFailure": true } }
  ]
}

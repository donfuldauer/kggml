{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "android-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/native-vulkan-${presetName}",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_shared"
      }
    },
    {
      "name": "android-arm64-v8a",
      "displayName": "Android arm64-v8a: libggml-vulkan.so backend module",
      "inherits": "android-base",
      "cacheVariables": { "ANDROID_ABI": "arm64-v8a" }
    },
    {
      "name": "desktop-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/native-vulkan-${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x86_64: libggml-vulkan.so backend module for the JVM desktop add-on (needs libvulkan-dev + glslc)",
      "inherits": "desktop-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64: ggml-vulkan.dll backend module for the JVM desktop add-on (MSVC + Vulkan SDK)",
      "inherits": "desktop-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android x86_64 (emulator): libggml-vulkan.so backend module",
      "inherits": "android-base",
      "cacheVariables": { "ANDROID_ABI": "x86_64" }
    }
  ]
}

# Kotlin/Native bindings for the kggml_diffusion C ABI (iosArm64, iosSimulatorArm64).
#
# The include directories (kggml-diffusion/native/include + kggml-runtime/native/include) are supplied by
# kggml-diffusion/build.gradle.kts. Symbols resolve at link time against the dynamic KggmlDiffusion.framework from
# KggmlDiffusion.xcframework (kggml-diffusion/native/scripts/build-ios-xcframework.sh), which itself links
# GgmlRuntime.framework; the consuming app or test binary supplies the framework search paths and embeds both.
package = com.donfuldauer.kggml.diffusion.cinterop
headers = kggml_diffusion.h
# kggml_runtime.h is included for kggml_status. (kggml_status_name() is bound by :kggml-runtime, not here.)
headerFilter = kggml_diffusion.h kggml_runtime.h
# Keep enums as plain integers so unknown (future) native values never crash the bindings.
nonStrictEnums = kggml_status kggml_backend_kind
linkerOpts = -framework KggmlDiffusion -framework GgmlRuntime

# kggml-diffusion CMake package.
#
# Provides:
#   kggml::diffusion - libkggml_diffusion (kggml_diffusion.h + stable-diffusion.h), stable-diffusion.cpp linked
#                      dynamically against kggml::runtime / kggml::ggml from the kggml-runtime package (which also
#                      carries the GGML_MAX_NAME=128 ABI definition).

@PACKAGE_INIT@

set(KGGML_DIFFUSION_UPSTREAM_COMMIT "@KGGML_DIFFUSION_UPSTREAM_COMMIT@")
set(KGGML_DIFFUSION_UPSTREAM_VERSION "@KGGML_DIFFUSION_UPSTREAM_VERSION@")

include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(kggml-runtime 1.0 CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/kggml-diffusion-targets.cmake")

check_required_components(kggml-diffusion)

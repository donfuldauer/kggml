{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "host-base",
      "hidden": true,
      "inherits": "base",
      "description": "Host build into <repo>/build/native-whisper against the runtime in <repo>/build/native.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/native-whisper",
      "installDir": "${sourceDir}/../../build/native-install",
      "cacheVariables": {
        "kggml-runtime_DIR": "${sourceDir}/../../build/native",
        "KGGML_WHISPER_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x86_64 (host, tests)",
      "inherits": "host-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64 (host, tests)",
      "inherits": "host-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (host, tests, MSVC)",
      "inherits": "host-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" }
    },
    {
      "name": "android-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/native-whisper-${presetName}",
      "installDir": "${sourceDir}/../../build/native-install/${presetName}",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_shared",
        "kggml-runtime_DIR": "${sourceDir}/../../build/native-${presetName}",
        "KGGML_WHISPER_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "android-arm64-v8a",
      "displayName": "Android arm64-v8a",
      "inherits": "android-base",
      "cacheVariables": { "ANDROID_ABI": "arm64-v8a" }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android x86_64 (emulator)",
      "inherits": "android-base",
      "cacheVariables": { "ANDROID_ABI": "x86_64" }
    },
    {
      "name": "ios-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/../../build/native-whisper-${presetName}",
      "installDir": "${sourceDir}/../../build/native-install/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.4",
        "CMAKE_XCODE_ATTRIBUTE_ONLY_ACTIVE_ARCH": "NO",
        "kggml-runtime_DIR": "${sourceDir}/../../build/native-${presetName}",
        "KGGML_WHISPER_COREML": "ON",
        "KGGML_WHISPER_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "ios-device",
      "displayName": "iOS device arm64 (KggmlWhisper.framework, CoreML)",
      "inherits": "ios-base",
      "cacheVariables": { "CMAKE_OSX_SYSROOT": "iphoneos" }
    },
    {
      "name": "ios-simulator-arm64",
      "displayName": "iOS simulator arm64 (KggmlWhisper.framework, CoreML)",
      "inherits": "ios-base",
      "cacheVariables": { "CMAKE_OSX_SYSROOT": "iphonesimulator" }
    }
  ],
  "buildPresets": [
    { "name": "linux-x64", "configurePreset": "linux-x64" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "windows-x64", "configurePreset": "windows-x64" },
    { "name": "android-arm64-v8a", "configurePreset": "android-arm64-v8a" },
    { "name": "android-x86_64", "configurePreset": "android-x86_64" },
    { "name": "ios-device", "configurePreset": "ios-device", "configuration": "Release" },
    { "name": "ios-simulator-arm64", "configurePreset": "ios-simulator-arm64", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "linux-x64", "configurePreset": "linux-x64", "output": { "outputOnFailure": true } },
    { "name": "macos-arm64", "configurePreset": "macos-arm64", "output": { "outputOnFailure": true } },
    { "name": "windows-x64", "configurePreset": "windows-x64", "output": { "outputOnFailure": true } }
  ]
}

{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "android-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/native-opencl-${presetName}",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_shared"
      }
    },
    {
      "name": "android-arm64-v8a",
      "displayName": "Android arm64-v8a: libggml-opencl.so backend module",
      "inherits": "android-base",
      "cacheVariables": { "ANDROID_ABI": "arm64-v8a" }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android x86_64 (emulator): libggml-opencl.so backend module",
      "inherits": "android-base",
      "cacheVariables": { "ANDROID_ABI": "x86_64" }
    }
  ]
}
